# category:debug
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DYNAMIC_FTRACE=y

# category:immutable
CONFIG_DM_VERITY=m

# category:hardening
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,ipe,bpf"
CONFIG_SECURITY_DMESG_RESTRICT=y
# The lockdown LSM selects MODULE_SIG: modules are signed with a key made
# during the build. Unsigned modules still load, lockdown itself stays off.
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_SECURITY_YAMA=y

# category:wine
CONFIG_NTSYNC=m

# Not asked for by the check.
#
# Multi-generational LRU: better page reclaim under memory pressure, which
# is the normal state with a browser and zram swap.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# systemd sets net.core.default_qdisc to fq_codel and the kernel had none.
CONFIG_NET_SCH_FQ_CODEL=y
