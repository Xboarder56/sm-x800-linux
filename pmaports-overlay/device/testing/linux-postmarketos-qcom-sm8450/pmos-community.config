# What postmarketOS asks of a kernel for a device people use every day,
# merged after pmos.config. Without it the tablet could not mount an exFAT
# card or USB stick, had no driver for game controllers or for Logitech,
# Apple and Microsoft keyboards and mice, could not tether through a phone,
# and lacked the netfilter pieces containers, Waydroid and firewalld use.
#
# The lists are what "pmbootstrap kconfig check" reported for the categories
# of the "community" alias plus waydroid, uefi, iwd and nftables, run against
# the 7.2.8-r2 configuration:
#
#   pmbootstrap kconfig check --arch aarch64 -k --file CONFIG \
#       --categories community,waydroid,uefi,iwd,nftables
#
# Each option has the value the check prefers. Three are left out, so the
# hardening category does not pass: CFI needs clang, and the shadow call
# stack changes how every function is compiled, which cannot be tried on
# the Tab S8+ this package is shared with.

# category:default
CONFIG_NLS_ASCII=y
CONFIG_NULL_TTY=m
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y
CONFIG_UDMABUF=y
CONFIG_BPF_LSM=y
# BTF needs pahole at build time (makedepends).
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_FTRACE=y
CONFIG_KPROBE_EVENTS=y
CONFIG_KPROBES=y
CONFIG_SECURITY_PATH=y

# category:netmount
CONFIG_CACHEFILES=m
CONFIG_FSCACHE=y
CONFIG_NFS_FSCACHE=y
CONFIG_NFSD=m
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y
CONFIG_NFSD_PNFS=y
CONFIG_NFSD_BLOCKLAYOUT=y
CONFIG_NFSD_SCSILAYOUT=y
CONFIG_NFSD_V4_2_INTER_SSC=y

# category:accessibility
CONFIG_ACCESSIBILITY=y
CONFIG_A11Y_BRAILLE_CONSOLE=y
CONFIG_SPEAKUP=m
CONFIG_SPEAKUP_SYNTH_ACNTSA=m
CONFIG_SPEAKUP_SYNTH_APOLLO=m
CONFIG_SPEAKUP_SYNTH_AUDPTR=m
CONFIG_SPEAKUP_SYNTH_BNS=m
CONFIG_SPEAKUP_SYNTH_DECTLK=m
CONFIG_SPEAKUP_SYNTH_DECEXT=m
CONFIG_SPEAKUP_SYNTH_LTLK=m
CONFIG_SPEAKUP_SYNTH_SOFT=m
CONFIG_SPEAKUP_SYNTH_SPKOUT=m
CONFIG_SPEAKUP_SYNTH_TXPRT=m

# category:waydroid
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_NETFILTER_XTABLES_LEGACY=y

# category:iwd
CONFIG_CRYPTO_MD4=m

# category:nftables
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP_NF_NAT=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m

# category:containers
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_NETDEV=m
CONFIG_NF_TABLES_NETDEV=y

# category:zram
CONFIG_ZRAM_BACKEND_842=y
CONFIG_ZRAM_BACKEND_DEFLATE=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_LZO=y

# category:netboot
