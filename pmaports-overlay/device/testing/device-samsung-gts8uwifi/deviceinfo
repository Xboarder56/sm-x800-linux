# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy Tab S8 Ultra (Wi-Fi)"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-gts8uwifi"
deviceinfo_year="2022"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_external_storage="true"
deviceinfo_screen_width="1848"
deviceinfo_screen_height="2960"

# Bootloader related
# SM8450 (Waipio) mainline. Samsung download mode (Odin), boot header v4.
# boot-deploy's v4 path builds boot.img (kernel) + vendor_boot.img
# (mainline DTB + pmOS ramdisk + cmdline). The DTB is our own mainline
# sm8450-samsung-gts8uwifi.dtb, built by linux-postmarketos-qcom-sm8450.
#
# X900 bring-up uses boot-deploy's initramfs output inside uniLoader;
# Samsung ABL does not boot this mainline kernel/DTB directly. See docs/05
# and docs/14 for the BOOT-only image assembly used for the Ultra variant.
deviceinfo_flash_method="heimdall-bootimg"
deviceinfo_generate_bootimg="true"
deviceinfo_header_version="4"
deviceinfo_bootimg_qcdt="false"
deviceinfo_flash_pagesize="4096"
deviceinfo_dtb="qcom/sm8450-samsung-gts8uwifi"

# Load addresses MUST match what the Samsung bootloader expects. Values read
# from the STOCK vendor_boot.img header (unpack_bootimg):
#   kernel 0x00008000  ramdisk 0x02000000  tags 0x01e00000  dtb 0x01f00000
# i.e. base 0x00000000. mkbootimg's DEFAULT base is 0x10000000, which put every
# address 0x10000000 too high (kernel 0x10008000, tags 0x10000100, ...) so the
# bootloader loaded the kernel/tags/dtb where it never executes them -> silent
# boot failure with no console output.
#
# NOTE: boot-deploy only passes --base/--*_offset to mkbootimg on the legacy
# (header <=v2) path. For header v3/v4 it omits them entirely and mkbootimg
# falls back to its defaults, so the deviceinfo_flash_offset_* keys are IGNORED
# here. The only way to set them for v4 is bootimg_custom_args, which
# boot-deploy passes straight through to mkbootimg.
# X900XXU9DYDC has the same vendor_boot load-address fields as the X800 port.
deviceinfo_bootimg_custom_args="--base 0x00000000 --kernel_offset 0x00008000 --ramdisk_offset 0x02000000 --tags_offset 0x01e00000 --dtb_offset 0x01f00000"
deviceinfo_bootimg_append_seandroidenforce="true"
deviceinfo_flash_heimdall_partition_kernel="BOOT"
deviceinfo_flash_heimdall_partition_rootfs="USERDATA"

# VISIBLE boot: earlycon on the geni UART (0x0099c000, from the stock
# /chosen stdout-path) + fbcon on the simple-framebuffer (panel). tty0 so
# the log and login prompt render on the panel. The X800 port used
# PMOS_NO_OUTPUT_REDIRECT to keep pmOS from hiding the console behind its splash;
# this pmOS initramfs uses rd.info, supplied by the debug image builder.
# Retain ABL scanout until native X900 panel takeover is separately validated.
deviceinfo_kernel_cmdline="earlycon=qcom_geni,0x0099c000 console=tty0 fbcon=font:TER16x32 loglevel=8 clk_ignore_unused pd_ignore_unused arm-smmu.disable_bypass=0 PMOS_NO_OUTPUT_REDIRECT"
# First boot: the eventual rootfs target is userdata, matching the X800 port.
# Current X900 tests write BOOT only; USERDATA has not been flashed. Restore
# matching DYDC stock BOOT to return to Android (see docs/14). The X800
# android_restore.tar is not a recovery image for this hardware variant.
deviceinfo_rootfs_image_sector_size="4096"
# Carry stage 2 in the ramdisk so the first debug boot does not depend on
# a rootfs/boot image already having been written to USERDATA.
deviceinfo_create_initfs_extra="false"
