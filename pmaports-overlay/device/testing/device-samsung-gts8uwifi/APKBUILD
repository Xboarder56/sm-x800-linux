# Reference: <https://postmarketos.org/devicepkg>
# Experimental mainline bring-up package; see docs/14-gts8uwifi-bringup.md.
maintainer="Garrett Beasley <garrettbeasley@icloud.com>"
pkgname=device-samsung-gts8uwifi
pkgdesc="Samsung Galaxy Tab S8 Ultra (Wi-Fi) - mainline bring-up (SM8450)"
pkgver=0.1
pkgrel=9
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sm8450
	postmarketos-base
	mkbootimg
	android-tools
	mdev-conf
	linux-firmware-qcom
	linux-firmware-qca
	linux-firmware-ath11k
	bluez-btmgmt
	swclock-offset
	hexagonrpcd>=0.5.0_git20260824
	hexagonrpcd-udev
	libssc
	iio-sensor-proxy
	make-dynpart-mappings
	device-mapper
"
subpackages="$pkgname-systemd"
makedepends="devicepkg-dev"
source="
	deviceinfo
	mkinitfs-mdev.files
	mkinitfs-gpu-fw.files
	90-gts8uwifi-cs35l45-no-hibernate.rules
	ucm2/Samsung-Galaxy-Tab-S8-Ultra.conf
	ucm2/HiFi.conf
	Samsung-Galaxy-Tab-S8-Ultra-tplg.bin
	usb-gadget.sh
	usb-gadget.service
	80-gts8uwifi.preset
	81-libssc-samsung-gts8uwifi.rules
	90-gts8uwifi-hexagonrpcd-sdsp.rules
	hexagonrpcd-sdsp-sensor-tree.conf
	bt-addr.sh
	bt-addr.conf
	bt-addr.service
	90-gts8uwifi-bt-addr.rules
	fw-extract.sh
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	# Add /lib/mdev/persistent-storage to the first-stage initramfs.
	# Without it mdev cannot create /dev/disk/by-uuid symlinks and the
	# initramfs can never find root by UUID. See the file for details.
	install -Dm644 "$srcdir"/mkinitfs-mdev.files \
		"$pkgdir"/usr/share/mkinitfs/files/50-gts8uwifi-mdev.files

	# GPU firmware must ride in the first-stage initramfs: a7xx adreno
	# loads SQE at bind time, before the rootfs exists. See the file.
	install -Dm644 "$srcdir"/mkinitfs-gpu-fw.files \
		"$pkgdir"/usr/share/mkinitfs/files/60-gts8uwifi-gpu-fw.files

	# Audio: keep the CS35L45 amps out of runtime suspend (see the rule).
	install -Dm644 "$srcdir"/90-gts8uwifi-cs35l45-no-hibernate.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-gts8uwifi-cs35l45-no-hibernate.rules

	# Audio: UCM profile for the "Samsung-Galaxy-Tab-S8-Ultra" card. The
	# card driver name is "sm8450", so alsa-ucm-conf looks in
	# conf.d/sm8450/<card long name>.conf.
	install -Dm644 "$srcdir"/Samsung-Galaxy-Tab-S8-Ultra.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8450/Samsung-Galaxy-Tab-S8-Ultra.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8450/gts8uwifi/HiFi.conf

	# Audio: AudioReach topology, loaded by q6apm as
	# qcom/sm8450/<card model>-tplg.bin. The same bytes as the Tab S8+
	# package's file: linux-firmware's SM8450-HDK topology (BSD-3-Clause,
	# linux-msm/audioreach-topology) with the PRIMARY_MI2S_RX data line
	# moved from SD0 to SD1, see tools/mk-tplg.py. The X900 wires the
	# amplifiers to the same line.
	install -Dm644 "$srcdir"/Samsung-Galaxy-Tab-S8-Ultra-tplg.bin \
		"$pkgdir"/usr/lib/firmware/qcom/sm8450/Samsung-Galaxy-Tab-S8-Ultra-tplg.bin

	# The tablet as a USB device to a PC: NCM ethernet and ACM serial on
	# one configfs gadget. The unit is in -systemd.
	install -Dm755 "$srcdir"/usb-gadget.sh \
		"$pkgdir"/usr/bin/gts8uwifi-usb-gadget

	# Sensors: accelerometer mount matrix for iio-sensor-proxy's libssc
	# backend, keyed on the FastRPC node as device-fairphone-fp4 does.
	# hexagonrpcd is the port's patched build (pmaports-overlay/temp);
	# the version floor keeps Alpine's 0.4.0 from satisfying it.
	install -Dm644 "$srcdir"/81-libssc-samsung-gts8uwifi.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-samsung-gts8uwifi.rules

	# Bluetooth: the controller comes up unconfigured (no local-bd-address
	# from DT or bootloader). This hands hci0 an address with btmgmt; the
	# udev rule and unit that trigger it are in the systemd subpackage.
	# linux-firmware-qca has the controller's firmware. See the script
	# header for where the address comes from.
	install -Dm755 "$srcdir"/bt-addr.sh \
		"$pkgdir"/usr/bin/gts8uwifi-bt-addr
	install -Dm644 "$srcdir"/bt-addr.conf \
		"$pkgdir"/etc/conf.d/gts8uwifi-bt-addr

	# Extractor for device-signed blobs (zap shader, DSP images), the
	# stock Wi-Fi firmware set and the proprietary sensor registry
	# configs: we ship the TOOL, the user dumps the firmware from their
	# own device or from the stock firmware package. See the script.
	# make-dynpart-mappings and device-mapper are for its read of super.
	# linux-firmware-ath11k gives a first boot some Wi-Fi before the
	# extractor has run; on this tablet that is 2.4 GHz with most frames
	# lost, and the extracted set takes over from it.
	install -Dm755 "$srcdir"/fw-extract.sh \
		"$pkgdir"/usr/bin/gts8uwifi-fw-extract
}

systemd() {
	install_if="$pkgname=$pkgver-r$pkgrel systemd"
	# swclock-offset: the PMIC RTC is read only here and reads decades
	# behind. Its units save the difference to the system clock at
	# shutdown and apply it at boot, so the time is right without network.
	depends="unudhcpd-systemd swclock-offset-systemd
		hexagonrpcd-systemd iio-sensor-proxy-systemd"

	# USB gadget: built when the UDC appears (usb-gadget.target), with
	# unudhcpd@usb0 and a serial getty on ttyGS0 pulled in by the unit.
	install -Dm644 "$srcdir"/usb-gadget.service \
		"$subpkgdir"/usr/lib/systemd/system/gts8uwifi-usb-gadget.service
	install -d "$subpkgdir"/usr/lib/systemd/system/usb-gadget.target.wants
	ln -sf ../gts8uwifi-usb-gadget.service \
		"$subpkgdir"/usr/lib/systemd/system/usb-gadget.target.wants/gts8uwifi-usb-gadget.service

	# Vendor wants symlinks read "disabled" from is-enabled; the preset
	# makes the state read what it is.
	install -Dm644 "$srcdir"/80-gts8uwifi.preset \
		"$subpkgdir"/usr/lib/systemd/system-preset/80-gts8uwifi.preset

	# Sensor hub: start hexagonrpcd-sdsp when /dev/fastrpc-sdsp appears
	# (the unit's path condition is evaluated before the SLPI boots), and
	# only once the served sensor tree has been built (see the drop-in).
	install -Dm644 "$srcdir"/90-gts8uwifi-hexagonrpcd-sdsp.rules \
		"$subpkgdir"/usr/lib/udev/rules.d/90-gts8uwifi-hexagonrpcd-sdsp.rules
	install -Dm644 "$srcdir"/hexagonrpcd-sdsp-sensor-tree.conf \
		"$subpkgdir"/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d/10-gts8uwifi-sensor-tree.conf

	# Bluetooth public address: udev pulls the oneshot in when hci0 appears
	# (ENV{SYSTEMD_WANTS}), so the unit has no [Install] section.
	install -Dm644 "$srcdir"/bt-addr.service \
		"$subpkgdir"/usr/lib/systemd/system/gts8uwifi-bt-addr.service
	install -Dm644 "$srcdir"/90-gts8uwifi-bt-addr.rules \
		"$subpkgdir"/usr/lib/udev/rules.d/90-gts8uwifi-bt-addr.rules
}
