# Reference: <https://postmarketos.org/devicepkg>
# Experimental mainline bring-up package; see docs/14-gts8uwifi-bringup.md.
maintainer="Garrett Beasley <garrettbeasley@icloud.com>"
pkgname=device-samsung-gts8uwifi
pkgdesc="Samsung Galaxy Tab S8 Ultra (Wi-Fi) - mainline bring-up (SM8450)"
pkgver=0.1
pkgrel=4
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sm8450
	postmarketos-base
	mkbootimg
	android-tools
	mdev-conf
	linux-firmware-qcom
	make-dynpart-mappings
	device-mapper
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	mkinitfs-mdev.files
	mkinitfs-gpu-fw.files
	90-gts8uwifi-cs35l45-no-hibernate.rules
	ucm2/Samsung-Galaxy-Tab-S8-Ultra.conf
	ucm2/HiFi.conf
	Samsung-Galaxy-Tab-S8-Ultra-tplg.bin
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	# Add /lib/mdev/persistent-storage to the first-stage initramfs.
	# Without it mdev cannot create /dev/disk/by-uuid symlinks and the
	# initramfs can never find root by UUID. See the file for details.
	install -Dm644 "$srcdir"/mkinitfs-mdev.files \
		"$pkgdir"/usr/share/mkinitfs/files/50-gts8uwifi-mdev.files

	# GPU firmware must ride in the first-stage initramfs: a7xx adreno
	# loads SQE at bind time, before the rootfs exists. See the file.
	install -Dm644 "$srcdir"/mkinitfs-gpu-fw.files \
		"$pkgdir"/usr/share/mkinitfs/files/60-gts8uwifi-gpu-fw.files

	# Audio: keep the CS35L45 amps out of runtime suspend (see the rule).
	install -Dm644 "$srcdir"/90-gts8uwifi-cs35l45-no-hibernate.rules \
		"$pkgdir"/usr/lib/udev/rules.d/90-gts8uwifi-cs35l45-no-hibernate.rules

	# Audio: UCM profile for the "Samsung-Galaxy-Tab-S8-Ultra" card. The
	# card driver name is "sm8450", so alsa-ucm-conf looks in
	# conf.d/sm8450/<card long name>.conf.
	install -Dm644 "$srcdir"/Samsung-Galaxy-Tab-S8-Ultra.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8450/Samsung-Galaxy-Tab-S8-Ultra.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/sm8450/gts8uwifi/HiFi.conf

	# Audio: AudioReach topology, loaded by q6apm as
	# qcom/sm8450/<card model>-tplg.bin. The same bytes as the Tab S8+
	# package's file: linux-firmware's SM8450-HDK topology (BSD-3-Clause,
	# linux-msm/audioreach-topology) with the PRIMARY_MI2S_RX data line
	# moved from SD0 to SD1, see tools/mk-tplg.py. The X900 wires the
	# amplifiers to the same line.
	install -Dm644 "$srcdir"/Samsung-Galaxy-Tab-S8-Ultra-tplg.bin \
		"$pkgdir"/usr/lib/firmware/qcom/sm8450/Samsung-Galaxy-Tab-S8-Ultra-tplg.bin
}
