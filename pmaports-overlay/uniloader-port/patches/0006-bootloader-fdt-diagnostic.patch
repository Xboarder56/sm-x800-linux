From: SM-X900 bring-up workbench
Subject: [PATCH] boot: optionally display Samsung ABL's live memory map

The SM-X900 tiny diagnostic init reaches userspace, then takes a synchronous
external abort in clear_page. The sibling-derived memory banks pass a static
firmware reservation audit, but Samsung ABL patches its runtime FDT and the
ordinary Android shell cannot read it. Preserve the incoming arm64 x0 tree
before relocation, display its memory banks and any reservation still exposed
by the compiled tree, and halt before Linux can allocate the disputed pages.

This is an opt-in bring-up aid, disabled in both normal board defconfigs.
DTB_ENTRY temporarily serves as a 2 MiB scratch destination; the diagnostic
image builder checks it against all payload and loader ranges. It does not
print chosen/bootargs or device identifiers. This patch is not an upstream
support claim and should be removed or generalized before submission.

diff --git a/Kconfig b/Kconfig
index 3c2f3a5..793ceba 100644
--- a/Kconfig
+++ b/Kconfig
@@ -99,6 +99,18 @@ menu "Building options"
 		  Path to a NUL-terminated string, which is going to get
 		  embedded to uniLoader
 
+	config BOOTLOADER_FDT_DIAGNOSTIC
+		bool "Capture Samsung ABL's memory map and halt"
+		depends on SAMSUNG_GTS8UWIFI && LIBFDT && DTB_RELOCATE && POSITION_INDEPENDENT
+		default n
+		help
+		  SM-X900 bring-up diagnostic only. Before relocating uniLoader,
+		  copy the incoming arm64 x0 FDT (up to 2 MiB) to DTB_ENTRY.
+		  That scratch range must be writable, disjoint from uniLoader,
+		  and large enough for the bootloader FDT. Print the live memory
+		  banks and reservations our compiled DT would expose, then halt
+		  without loading Linux. Never enable in a normal boot image.
+
 endmenu
 
 source "drivers/Kconfig"
diff --git a/arch/aarch64/reloc.S b/arch/aarch64/reloc.S
index b6fb485..37ad946 100644
--- a/arch/aarch64/reloc.S
+++ b/arch/aarch64/reloc.S
@@ -26,6 +26,37 @@ ENTRY_ALIAS(_rel_stack_size)
 	.quad _reloc_size
 
 ENTRY_ALIAS( _reloc_entry)
+#ifdef CONFIG_BOOTLOADER_FDT_DIAGNOSTIC
+	/* x0 is the original FDT. Preserve it before image relocation can
+	 * overwrite ABL's source buffer; no stack or C runtime exists yet.
+	 */
+	cbz	x0, 3f
+	tst	x0, #7
+	b.ne	2f
+	ldr	w7, [x0]
+	ldr	w8, =0xedfe0dd0 /* FDT_MAGIC, little-endian load */
+	cmp	w7, w8
+	b.ne	2f
+	ldr	w7, [x0, #4]
+	rev	w7, w7 /* big-endian totalsize */
+	cmp	w7, #40
+	b.lo	2f
+	ldr	w8, =0x200000
+	cmp	w7, w8
+	b.hi	2f
+	ldr	x8, =CONFIG_DTB_ENTRY
+	mov	x9, x0
+	mov	x0, x8
+1:
+	ldrb	w10, [x9], #1
+	strb	w10, [x8], #1
+	subs	w7, w7, #1
+	b.ne	1b
+	b	3f
+2:
+	mov	x0, xzr
+3:
+#endif
 	adr	x4, _start
 	ldr	x5, _rel_stack_base
 	cmp	x4, x5
diff --git a/arch/aarch64/start.S b/arch/aarch64/start.S
index de454f9..c4f7992 100644
--- a/arch/aarch64/start.S
+++ b/arch/aarch64/start.S
@@ -23,6 +23,9 @@ _stack_size:
 .align 4
 #endif
 ENTRY(_start)
+#ifdef CONFIG_BOOTLOADER_FDT_DIAGNOSTIC
+	mov x19, x0 /* preserve incoming FDT across stack/BSS setup */
+#endif
 	/* Set up the base address for the stack */
 	adrp    x0, _stack_end      /* Load page of the _stack_end symbol */
 	add     x0, x0, #:lo12:_stack_end  /* Add the offset within the page */
@@ -52,6 +55,9 @@ ENTRY(_start)
 	add     x2, x2, #:lo12:ramdisk /* Add offset within the page */
 #endif
 
+#ifdef CONFIG_BOOTLOADER_FDT_DIAGNOSTIC
+	mov x3, x19
+#endif
 	bl main
 END(_start)
 
