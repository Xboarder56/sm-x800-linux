# Forked from Alpine (community/ksystemstats 6.7.5-r1) with one patch: a
# GPU backend for Qualcomm Adreno GPUs driven by msm. Upstream only looks
# for AMD, Intel and NVIDIA devices on the PCI bus, so Plasma's System
# Monitor shows no GPU sensors on a Qualcomm tablet. The patch is meant
# for upstream; this package goes away when a release carries it.
#
# Same pkgname and version as Alpine with a pkgrel far above theirs, so
# apk prefers it until Alpine moves to the next Plasma release. At that
# point Alpine's build takes over and the GPU sensors go away again until
# this aport is moved to the same release.
#
# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-plasma
maintainer="team/kde <bribbers@disroot.org>"
pkgname=ksystemstats
pkgver=6.7.5
pkgrel=101
pkgdesc="A plugin based system monitoring daemon"
# armhf blocked by qt6-qtdeclarative -> kio
arch="all !armhf"
url="https://kde.org/plasma-desktop/"
license="LicenseRef-KDE-Accepted-GPL AND LicenseRef-KDE-Accepted-LGPL AND CC0-1.0"
makedepends="
	eudev-dev
	extra-cmake-modules
	kcoreaddons-dev
	kdbusaddons-dev
	kio-dev
	libcap
	libksysguard-dev
	libnl3-dev
	lm-sensors-dev
	networkmanager-qt-dev
	qt6-qtbase-dev
	samurai
	solid-dev
	"
checkdepends="xwayland-run"
case "$pkgver" in
	*.*.9*) _rel=unstable;;
	*) _rel=stable;;
esac
subpackages="
	$pkgname-systemd
	$pkgname-lang
	"
_repo_url="https://invent.kde.org/plasma/ksystemstats.git"
source="https://download.kde.org/$_rel/plasma/$pkgver/ksystemstats-$pkgver.tar.xz
	0001-plugins-gpu-add-a-backend-for-Adreno-GPUs-driven-by-.patch
	"
options="setcap"
case "$CARCH" in
	# s390x and ppc6l4 have no enabled tests at this moment
	s390x|ppc64le) options="$options !check" ;;
esac

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

check() {
	local skipped_tests="ksystemstatstest"
	local tests=""
	case "$CARCH" in
		# Test thinks these architectures are AMD64, unsupported upstream
		ppc64le|s390x) tests="$tests TestLinuxCpu" ;;
		*) ;;
	esac
	for test in $tests; do
		skipped_tests="$skipped_tests|$test"
	done
	wlheadless-run -- ctest --test-dir build -E "$skipped_tests"
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

