bc3dbc186a41b589c2685f9ad6d8e6dd4ce08a544d61f0b91494c799ec95265e5dab9e6091e89553c7459137321eb854913bfc835740f1fc41d49c7b0dfcb12f  0001-plugins-gpu-add-a-backend-for-Adreno-GPUs-driven-by-.patch
"
