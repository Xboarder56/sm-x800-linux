new file mode 100644
index 0000000..8920652
--- /dev/null
+++ b/plugins/gpu/LinuxMsmGpu.h
@@ -0,0 +1,60 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Garrett Beasley
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#pragma once
+
+#include <QElapsedTimer>
+#include <QHash>
+#include <QStringList>
+
+#include "GpuDevice.h"
+
+struct udev_device;
+
+namespace KSysGuard
+{
+class SysFsSensor;
+}
+
+/**
+ * A Qualcomm Adreno GPU driven by the msm DRM driver.
+ *
+ * These are platform devices, so nothing is found on the PCI bus. The
+ * frequency comes from the devfreq device, the temperature from the SoC's
+ * GPU thermal zones and the usage from the engine time each DRM client
+ * reports in its fdinfo.
+ */
+class LinuxMsmGpu : public GpuDevice
+{
+    Q_OBJECT
+
+public:
+    LinuxMsmGpu(const QString &id, const QString &name, udev_device *device);
+
+    void initialize() override;
+    void update() override;
+
+    static QString deviceName(udev_device *device);
+
+protected:
+    void makeSensors() override;
+
+private:
+    void findClients();
+    void updateUsage();
+    void updateTemperature();
+
+    QString m_devfreqPath;
+    QStringList m_thermalZones;
+    KSysGuard::SysFsSensor *m_frequencySensor = nullptr;
+
+    // fdinfo files of the DRM clients found by the last scan of /proc
+    QStringList m_clients;
+    // Engine time in nanoseconds, by DRM client id
+    QHash<quint64, quint64> m_engineTime;
+    QElapsedTimer m_lastScan;
+    QElapsedTimer m_lastUsage;
+};
