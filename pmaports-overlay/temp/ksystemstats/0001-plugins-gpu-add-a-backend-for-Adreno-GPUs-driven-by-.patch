+++ b/plugins/gpu/CMakeLists.txt
@@ -9,7 +9,7 @@ if(CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
 endif()
 
 if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
-    target_sources(ksystemstats_plugin_gpu PRIVATE LinuxAmdGpu.cpp LinuxIntelGpu.cpp LinuxNvidiaGpu.cpp LinuxBackend.cpp NvidiaGpu.cpp NvidiaSmiProcess.cpp)
+    target_sources(ksystemstats_plugin_gpu PRIVATE LinuxAmdGpu.cpp LinuxIntelGpu.cpp LinuxMsmGpu.cpp LinuxNvidiaGpu.cpp LinuxBackend.cpp NvidiaGpu.cpp NvidiaSmiProcess.cpp)
 
     add_executable(ksystemstats_intel_helper IntelHelper.cpp)
     configure_file(IntelHelperLocation.h.cmake IntelHelperLocation.h)
diff --git a/plugins/gpu/LinuxBackend.cpp b/plugins/gpu/LinuxBackend.cpp
index 139d8a0..d369528 100644
--- a/plugins/gpu/LinuxBackend.cpp
+++ b/plugins/gpu/LinuxBackend.cpp
@@ -14,6 +14,7 @@
 
 #include "LinuxAmdGpu.h"
 #include "LinuxIntelGpu.h"
+#include "LinuxMsmGpu.h"
 #include "LinuxNvidiaGpu.h"
 #include "debug.h"
 
@@ -78,6 +79,30 @@ void LinuxBackend::start()
     }
 
     udev_enumerate_unref(enumerate);
+
+    // Qualcomm Adreno GPUs are platform devices
+    enumerate = udev_enumerate_new(m_udev);
+    udev_enumerate_add_match_subsystem(enumerate, "platform");
+    udev_enumerate_add_match_property(enumerate, "DRIVER", "adreno");
+    udev_enumerate_scan_devices(enumerate);
+
+    devices = udev_enumerate_get_list_entry(enumerate);
+    for (auto entry = devices; entry; entry = udev_list_entry_get_next(entry)) {
+        auto device = udev_device_new_from_syspath(m_udev, udev_list_entry_get_name(entry));
+        if (!device) {
+            continue;
+        }
+
+        auto gpu = new LinuxMsmGpu{QStringLiteral("gpu%1").arg(gpuNumber), LinuxMsmGpu::deviceName(device), device};
+        gpu->initialize();
+        m_devices.append(gpu);
+        Q_EMIT deviceAdded(gpu);
+        gpuNumber++;
+
+        udev_device_unref(device);
+    }
+
+    udev_enumerate_unref(enumerate);
 }
 
 void LinuxBackend::stop()
diff --git a/plugins/gpu/LinuxMsmGpu.cpp b/plugins/gpu/LinuxMsmGpu.cpp
new file mode 100644
index 0000000..9e0871f
--- /dev/null
+++ b/plugins/gpu/LinuxMsmGpu.cpp
@@ -0,0 +1,256 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Garrett Beasley
+ *
+ * SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+ */
+
+#include "LinuxMsmGpu.h"
+
+#include <QDir>
+#include <QFile>
+#include <QRegularExpression>
+
+#include <algorithm>
+
+#include <dirent.h>
+#include <fcntl.h>
+#include <libudev.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+
+#include <systemstats/SysFsSensor.h>
+
+using namespace Qt::StringLiterals;
+
+// Character device major of DRM nodes
+static const unsigned int drmMajor = 226;
+// How often /proc is searched for new DRM clients, in milliseconds
+static const qint64 scanInterval = 5000;
+
+struct ClientInfo {
+    bool valid = false;
+    quint64 id = 0;
+    quint64 engineTime = 0;
+};
+
+static ClientInfo readClient(const QString &path)
+{
+    ClientInfo info;
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return info;
+    }
+
+    bool isMsm = false;
+    bool hasId = false;
+    const auto lines = file.readAll().split('\n');
+    for (const auto &line : lines) {
+        const auto separator = line.indexOf(':');
+        if (separator < 0) {
+            continue;
+        }
+        const auto key = QByteArrayView(line).first(separator).trimmed();
+        const auto value = QByteArrayView(line).sliced(separator + 1).trimmed();
+
+        if (key == "drm-driver") {
+            isMsm = value == "msm";
+        } else if (key == "drm-client-id") {
+            info.id = value.toULongLong(&hasId);
+        } else if (key == "drm-engine-gpu") {
+            // "<number> ns"
+            const auto end = value.indexOf(' ');
+            info.engineTime = (end < 0 ? value : value.first(end)).toULongLong();
+        }
+    }
+
+    info.valid = isMsm && hasId;
+    return info;
+}
+
+LinuxMsmGpu::LinuxMsmGpu(const QString &id, const QString &name, udev_device *device)
+    : GpuDevice(id, name)
+{
+    const auto devicePath = QString::fromLocal8Bit(udev_device_get_syspath(device));
+
+    const auto devfreq = QDir(devicePath + "/devfreq"_L1).entryList(QDir::Dirs | QDir::NoDotAndDotDot);
+    if (!devfreq.isEmpty()) {
+        m_devfreqPath = devicePath + "/devfreq/"_L1 + devfreq.first();
+    }
+
+    // Thermal zones have no link to the device they measure. Qualcomm device
+    // trees name the ones on the GPU "gpu-top-thermal", "gpuss0-thermal", ...
+    const QDir thermal(u"/sys/class/thermal"_s);
+    const auto zones = thermal.entryList({u"thermal_zone*"_s}, QDir::Dirs);
+    for (const auto &zone : zones) {
+        QFile type(thermal.filePath(zone) + "/type"_L1);
+        if (type.open(QIODevice::ReadOnly) && type.readAll().startsWith("gpu")) {
+            m_thermalZones << thermal.filePath(zone) + "/temp"_L1;
+        }
+    }
+}
+
+QString LinuxMsmGpu::deviceName(udev_device *device)
+{
+    // "qcom,adreno-730.1" is an Adreno 730, patch level 1
+    static const QRegularExpression model(u"^qcom,adreno-(\\d+)\\.\\d+$"_s);
+    const auto match = model.match(QString::fromLatin1(udev_device_get_property_value(device, "OF_COMPATIBLE_0")));
+    if (match.hasMatch()) {
+        return u"Adreno %1"_s.arg(match.captured(1));
+    }
+    return u"Adreno"_s;
+}
+
+void LinuxMsmGpu::initialize()
+{
+    GpuDevice::initialize();
+
+    if (m_devfreqPath.isEmpty()) {
+        return;
+    }
+    QFile maxFreq(m_devfreqPath + "/max_freq"_L1);
+    if (maxFreq.open(QIODevice::ReadOnly)) {
+        m_coreFrequencyProperty->setMax(qreal(maxFreq.readAll().trimmed().toULongLong() / 1000000));
+    }
+}
+
+void LinuxMsmGpu::makeSensors()
+{
+    m_nameProperty = new KSysGuard::SensorProperty(u"name"_s, this);
+    m_usageProperty = new KSysGuard::SensorProperty(u"usage"_s, u"usage"_s, 0, this);
+    // The GPU shares the system memory and the driver has no total for what
+    // it uses, so these two stay without a value.
+    m_totalVramProperty = new KSysGuard::SensorProperty(u"totalVram"_s, this);
+    m_usedVramProperty = new KSysGuard::SensorProperty(u"usedVram"_s, this);
+    m_memoryFrequencyProperty = new KSysGuard::SensorProperty(u"memoryFrequency"_s, u"memoryFrequency"_s, 0, this);
+    m_temperatureProperty = new KSysGuard::SensorProperty(u"temperature"_s, u"temperature"_s, 0, this);
+    m_powerProperty = new KSysGuard::SensorProperty(u"power"_s, u"power"_s, 0, this);
+
+    if (m_devfreqPath.isEmpty()) {
+        m_coreFrequencyProperty = new KSysGuard::SensorProperty(u"coreFrequency"_s, u"coreFrequency"_s, 0, this);
+        return;
+    }
+    m_frequencySensor = new KSysGuard::SysFsSensor(u"coreFrequency"_s, m_devfreqPath + "/cur_freq"_L1, 0, this);
+    m_frequencySensor->setConvertFunction([](const QByteArray &input) {
+        // Hz to MHz
+        return input.trimmed().toULongLong() / 1000000;
+    });
+    m_coreFrequencyProperty = m_frequencySensor;
+}
+
+void LinuxMsmGpu::update()
+{
+    if (m_frequencySensor) {
+        m_frequencySensor->update();
+    }
+    updateTemperature();
+    updateUsage();
+}
+
+void LinuxMsmGpu::updateTemperature()
+{
+    if (m_thermalZones.isEmpty() || !m_temperatureProperty->isSubscribed()) {
+        return;
+    }
+
+    // The hottest of the zones, they are reported in millidegrees
+    bool found = false;
+    qlonglong temperature = 0;
+    for (const auto &zone : std::as_const(m_thermalZones)) {
+        QFile file(zone);
+        if (!file.open(QIODevice::ReadOnly)) {
+            continue;
+        }
+        bool ok = false;
+        const auto value = file.readAll().trimmed().toLongLong(&ok);
+        if (ok && (!found || value > temperature)) {
+            temperature = value;
+            found = true;
+        }
+    }
+    if (found) {
+        m_temperatureProperty->setValue(temperature / 1000.0);
+    }
+}
+
+void LinuxMsmGpu::findClients()
+{
+    m_clients.clear();
+
+    DIR *proc = opendir("/proc");
+    if (!proc) {
+        return;
+    }
+    while (auto entry = readdir(proc)) {
+        if (entry->d_name[0] < '0' || entry->d_name[0] > '9') {
+            continue;
+        }
+        // Fails for processes of other users, which leaves them out
+        const QByteArray fdPath = "/proc/" + QByteArray(entry->d_name) + "/fd";
+        DIR *fds = opendir(fdPath.constData());
+        if (!fds) {
+            continue;
+        }
+        while (auto fd = readdir(fds)) {
+            struct stat info;
+            if (fd->d_name[0] == '.' || fstatat(dirfd(fds), fd->d_name, &info, 0) != 0) {
+                continue;
+            }
+            if (!S_ISCHR(info.st_mode) || major(info.st_rdev) != drmMajor) {
+                continue;
+            }
+            const QByteArray fdinfo = "/proc/" + QByteArray(entry->d_name) + "/fdinfo/" + fd->d_name;
+            const auto path = QString::fromLatin1(fdinfo);
+            if (readClient(path).valid) {
+                m_clients << path;
+            }
+        }
+        closedir(fds);
+    }
+    closedir(proc);
+}
+
+void LinuxMsmGpu::updateUsage()
+{
+    if (!m_usageProperty->isSubscribed()) {
+        // Start over when somebody is interested again
+        m_lastUsage.invalidate();
+        m_lastScan.invalidate();
+        return;
+    }
+
+    // Looking at every file descriptor of every process is expensive, so it
+    // is not done on each update. A new client is noticed at the next scan.
+    if (!m_lastScan.isValid() || m_lastScan.elapsed() >= scanInterval) {
+        findClients();
+        m_lastScan.start();
+    }
+
+    // A client can be open in more than one process or more than once in a
+    // process, count it once.
+    QHash<quint64, quint64> engineTime;
+    for (const auto &path : std::as_const(m_clients)) {
+        const auto client = readClient(path);
+        if (client.valid) {
+            engineTime[client.id] = client.engineTime;
+        }
+    }
+
+    if (m_lastUsage.isValid()) {
+        const auto elapsed = m_lastUsage.nsecsElapsed();
+        quint64 busy = 0;
+        for (auto it = engineTime.constBegin(); it != engineTime.constEnd(); ++it) {
+            const auto previous = m_engineTime.constFind(it.key());
+            if (previous != m_engineTime.constEnd() && it.value() > previous.value()) {
+                busy += it.value() - previous.value();
+            }
+        }
+        if (elapsed > 0) {
+            m_usageProperty->setValue(std::min(100.0, busy * 100.0 / elapsed));
+        }
+    }
+
+    m_engineTime = engineTime;
+    m_lastUsage.start();
+}
+
+#include "moc_LinuxMsmGpu.cpp"
